TELEGRAM_BOT_TOKEN=your_token_here
ANTHROPIC_API_KEY=your_key_here
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
# Veo video generation (Vertex AI model ID; smoke-tested on veo-3.1-generate-001):
VEO_MODEL=veo-3.1-generate-001
# Per-clip length in seconds (Veo 3.1 supports 4, 6, or 8; 8 is the max):
# VEO_DURATION_SECONDS=8
# Max scenes stitched for a "full" video (total length = scenes x duration):
# VEO_MAX_SCENES=3
# Only needed if Veo on your project requires GCS output (the bytes path is tried first):
# GCS_OUTPUT_BUCKET=gs://your-bucket-name
# Production only — service-account key JSON contents (single line):
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Instagram Tone-of-Voice extraction via Apify (get token at apify.com → Settings → Integrations):
# APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxx
# Local SQLite (no Docker needed):
DATABASE_URL=sqlite+aiosqlite:///./social.db
# Production PostgreSQL (Docker / Railway):
# DATABASE_URL=postgresql+asyncpg://social:secret@db:5432/social
