TELEGRAM_BOT_TOKEN=your_token_here
ANTHROPIC_API_KEY=your_key_here
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
# Veo video generation (verify the model ID is enabled in your project's Model Garden):
VEO_MODEL=veo-3.1-generate-preview
# Only needed if Veo on your project requires GCS output (the bytes path is tried first):
# GCS_OUTPUT_BUCKET=gs://your-bucket-name
# Production only — service-account key JSON contents (single line):
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Local SQLite (no Docker needed):
DATABASE_URL=sqlite+aiosqlite:///./social.db
# Production PostgreSQL (Docker / Railway):
# DATABASE_URL=postgresql+asyncpg://social:secret@db:5432/social
